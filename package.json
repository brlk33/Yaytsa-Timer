{
  "name": "yaytsa-timer",
  "productName": "Yaytsa Timer",
  "version": "1.0.0",
  "description": "Яйца Таймер — помодоро-таймер и учёт рабочих часов для Windows",
  "main": "src/main.js",
  "author": "brlk33",
  "license": "MIT",
  "repository": "https://github.com/brlk33/Yaytsa-Timer",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  },
  "devDependencies": {
    "electron": "39.8.10",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.yaytsa.timer",
    "productName": "Yaytsa Timer",
    "executableName": "YaytsaTimer",
    "copyright": "Яйца Cloud",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["src/**/*", "package.json"],
    "electronLanguages": ["en-US", "ru"],
    "win": {
      "target": ["nsis"],
      "icon": "build/icon.ico",
      "artifactName": "YaytsaTimer-Setup.${ext}",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Яйца Таймер",
      "uninstallDisplayName": "Яйца Таймер",
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerLanguages": ["ru_RU", "en_US"],
      "language": "1049",
      "deleteAppDataOnUninstall": false
    },
    "publish": [{ "provider": "github", "owner": "brlk33", "repo": "Yaytsa-Timer", "releaseType": "release" }]
  }
}
